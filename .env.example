# ========================================================
# MICROSOFT DEFENDER XDR & ENTRA ID AUTHENTICATION
# ========================================================
# Create an App Registration in Azure Portal (portal.azure.com):
# 1. Go to Microsoft Entra ID -> App registrations -> New registration
# 2. Add API permissions (Microsoft Graph -> Application Permissions):
#    - SecurityAlert.Read.All (or SecurityAlert.ReadWrite.All)
#    - SecurityIncident.Read.All (or SecurityIncident.ReadWrite.All)
#    - User.ReadWrite.All (Optional, for revoking sessions)
# 3. Click "Grant admin consent for <tenant>"
# 4. Certificates & secrets -> New client secret -> Copy Value
# ========================================================
AZURE_TENANT_ID=your-azure-tenant-id-here
AZURE_CLIENT_ID=your-azure-client-id-here
AZURE_CLIENT_SECRET=your-azure-client-secret-here

# Set to true to force simulation / demo mode even if Azure credentials are set
FORCE_MOCK=false

# ========================================================
# AI / LLM ENGINE CONFIGURATION
# ========================================================
# Options: "gemini", "openai", "claude", "copilot", "azure_openai", "ollama", "heuristic"
# (If API keys are left unset, the agent automatically falls back
# to the built-in Expert SOC Heuristic Engine with 0 external calls)
LLM_PROVIDER=gemini

# 1. Google Gemini (Default)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# 2. OpenAI / ChatGPT (gpt-4o, o3-mini, o1)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# 3. Anthropic Claude (claude-3-7-sonnet, claude-3-5-sonnet)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# 4. Microsoft Copilot / Azure OpenAI Service (Enterprise SecOps)
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# 5. Ollama / Local Offline Models (Llama 3.3, DeepSeek-R1)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.3

# ========================================================
# SOC DASHBOARD SERVER CONFIGURATION
# ========================================================
HOST=127.0.0.1
PORT=8000
